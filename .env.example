# Open Cloud API key with the "thumbnails" -> "read" permission.
# Create one at https://create.roblox.com/dashboard/credentials
# Rename this file to .env (or paste the key in the web UI instead).
ROBLOX_API_KEY=
PORT=3000

# Alternative to an API key: the .ROBLOSECURITY cookie of a throwaway account.
# This grants FULL access to that account - never use your main account's cookie.
ROBLOX_COOKIE=
